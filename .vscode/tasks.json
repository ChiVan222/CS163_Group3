{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\raylib\\w64devkit\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/*.cpp",
				"${workspaceFolder}/src/DataStructures/SinglyLinkedList/*.cpp",
				"${workspaceFolder}/src/DataStructures/Graph/*.cpp",
				"${workspaceFolder}/src/DataStructures/Heap/*.cpp",
                "${workspaceFolder}/src/DataStructures/Trie/*.cpp",
				"${workspaceFolder}/src/Visualizer/*.cpp",
                "-IC:\\raylib\\raylib\\src",
                "-L:\\C:\\raylib\\raylib\\src",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm",
                "-v",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
